# Recommended for independent developers: https://gnews.io/
# Server-only secret. Never prefix this value with EXPO_PUBLIC_.
GNEWS_API_KEY=replace-with-your-gnews-api-key

# Optional alternative provider.
NEWSAPI_AI_KEY=

# Optional market data provider. Server-only secret.
TWELVE_DATA_API_KEY=

# URL used by the mobile app. This default works in the iOS simulator.
EXPO_PUBLIC_NEWS_API_URL=http://127.0.0.1:8787

# Optional local proxy configuration.
NEWS_PROXY_PORT=8787
NEWS_CACHE_TTL_SECONDS=1800
# SQLite database. Use a persistent volume in production.
NEWS_DB_FILE=.cache/news.sqlite
# Legacy JSON cache location, read only to migrate existing results.
NEWS_CACHE_FILE=.cache/news-feed.json

# Safe default: only image hosts explicitly allowlisted below are returned.
NEWS_IMAGE_POLICY=licensed-only
NEWS_IMAGE_ALLOWED_HOSTS=
# Exact HTTPS hosts explicitly authorized for storage and offline copies.
# Also include them in NEWS_IMAGE_ALLOWED_HOSTS. Empty disables image storage.
NEWS_IMAGE_ARCHIVE_HOSTS=

# Local evaluation only: set NEWS_IMAGE_POLICY=development to preview the
# unverified publisher images returned by the aggregator. Do not use in production.
